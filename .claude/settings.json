            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"${CLAUDE_PROJECT_DIR}/scripts/registrar_prompt_ia.py\" --herramienta \"Claude Code\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
